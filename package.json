{
  "name": "urlshawtie-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack URL shortener application",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:backend": "backend\\venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --port 8000 --reload --reload-dir backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "backend\\venv\\Scripts\\python.exe backend\\test_e2e.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
